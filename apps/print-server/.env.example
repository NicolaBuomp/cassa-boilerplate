# Copiare in .env sul PC del banco.

# La service-role key bypassa la RLS: questo file non deve MAI finire su un
# client né in un repository.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Intestazione stampata in cima al promemoria (se non c'è assets/logo.png).
INTESTAZIONE=ROXY

# printer:auto usa la stampante predefinita di Windows.
# Usare "console" (o PRINTER_DRY_RUN=true) per provare senza hardware.
PRINTER_INTERFACE=printer:auto
PRINTER_TYPE=epson
PRINTER_WIDTH=48
PRINTER_CHARSET=PC852_LATIN2
PRINTER_DRY_RUN=false

POLL_INTERVAL_MS=15000
MAX_ATTEMPTS=3
